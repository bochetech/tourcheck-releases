# El proveedor de LLM está detrás de una interfaz compatible con OpenAI.
# Cambiar de modelo local a modelo en la nube es cambiar estas dos líneas.

# --- Desarrollo: Ollama o LM Studio en el Mac (coste 0) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
AULA_MODELO=qwen2.5:7b

# --- Sesiones reales: API en la nube (2-8 USD/mes) ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# AULA_MODELO=gpt-5-mini

# Presupuesto de contexto recuperado por turno, en tokens.
# Por encima de esto un modelo local de 7-12B empieza a degradarse.
AULA_MAX_TOKENS_RAG=1500

DATABASE_URL=postgresql://aula:aula@localhost:5432/aula
